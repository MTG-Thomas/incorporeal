{
	"name": "incorporeal",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "A Cloudflare-native organization of persistent, proactive Pi agents on Workers Free.",
	"license": "AGPL-3.0-only",
	"engines": {
		"node": ">=22.19"
	},
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"typecheck": "tsc --noEmit",
		"build": "wrangler deploy --dry-run --outdir dist",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "npm run typecheck && npm run test",
		"cli": "node scripts/orgctl.mjs"
	},
	"dependencies": {
		"@earendil-works/chord": "^1.3.0",
		"@earendil-works/pi-ai": "1.3.0",
		"@earendil-works/pi-durable": "1.3.0",
		"agents": "0.32.0"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.4.6",
		"@cloudflare/workers-types": "^5.20261019.1",
		"@types/node": "^22.10.0",
		"typescript": "^5.7.0",
		"vitest": "^5.0.5",
		"wrangler": "^4.151.3"
	}
}
