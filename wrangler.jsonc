{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "incorporeal",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-20",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"observability": {
		"enabled": true
	},
	// One Durable Object class hosts every agent. Identity comes from the
	// object's name (the agent id), not from the class, so an agent can be
	// replaced without a migration. SQLite-backed, which is the only backend
	// available on the Workers Free plan.
	"durable_objects": {
		"bindings": [
			{
				"name": "ORG_AGENTS",
				"class_name": "OrgAgent"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["OrgAgent"]
		}
	],
	// Shared operational state. Replace `database_id` with the id printed by
	// `npx wrangler d1 create incorporeal`.
	"d1_databases": [
		{
			"binding": "ORG_DB",
			"database_name": "incorporeal",
			"database_id": "7a2b6d43-3a63-4586-bd1e-29c9238ce06c",
			"migrations_dir": "migrations"
		}
	],
	// Workers AI. The Free plan grants 10,000 neurons/day; see docs/free-tier.md.
	"ai": {
		"binding": "AI"
	},
	// Local development may pretend to be an authenticated operator by adding
	// an "access" block with a "dev" identity to this file. It is left out on
	// purpose: the test pool reads this file, and an access block makes it
	// open a real Access session instead of running locally.
	// The only cron trigger in the system. It does nothing but hand the
	// obligation sweep to the coordinator Durable Object, because a Workers
	// Free invocation gets 10 ms of CPU while a Durable Object gets 30 s.
	"triggers": {
		"crons": ["*/15 * * * *"]
	},
	"vars": {
		"ORG_ENV": "production",
		// When Cloudflare Access is in front, only these identities may drive
		// the organization. A machine caller (the CLI, the webhook sender)
		// has no email and is authorised by its token instead.
		"CF_ACCESS_ALLOWED_EMAILS": "thomas@midtowntg.com",
		"MODEL_DEFAULT": "@cf/zai-org/glm-4.7-flash",
		"MODEL_COORDINATOR": "@cf/zai-org/glm-4.7-flash",
		"MODEL_ENGINEER": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
		"MODEL_REVIEWER": "@cf/zai-org/glm-4.7-flash",
		"THINKING_LEVEL": "low",
		// Optional: route Workers AI through this AI Gateway so a spend rule
		// can cap model dollars. Empty means the binding is called directly.
		// The shipped default is no gateway; the runbook's $0 rule applies
		// once the operator sets this to a real gateway id.
		"AI_GATEWAY_ID": "",
		"EXECUTION_BACKEND": "simulated",
		"REPO_PROVIDER": "simulated",
		"SIMULATED_REPO_STATE": "{\"ciStatus\":\"failing\",\"workflow\":\"build-and-test\",\"branch\":\"main\",\"issue\":\"Simulated CI failure: the nightly workflow failed.\"}"
	}
}
